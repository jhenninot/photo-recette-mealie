# Clé API Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modèles Gemini (facultatif) : lecture de la recette et génération d'image
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Mealie : URL interne utilisée par le serveur, et jeton API (Profil > Jetons API dans Mealie)
MEALIE_URL=http://mealie:9000
MEALIE_TOKEN=
# URL publique de Mealie pour les liens affichés dans l'application (par défaut = MEALIE_URL)
MEALIE_PUBLIC_URL=https://mealie.example.com

# Premier administrateur, créé au démarrage si aucun compte n'existe
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Facultatif : secret de signature des sessions (sinon généré dans data/jwt-secret)
# JWT_SECRET=
PORT=3000
